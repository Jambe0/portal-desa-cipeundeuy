# Salin menjadi `.env` privat di Application Root, lalu isi nilai sebenarnya.
# Jangan commit atau letakkan `.env` di dalam public_html.
APP_URL="https://desa.example.id"
AUTH_SECRET=""
ANALYTICS_SALT=""
# Biarkan false sampai support memastikan header proxy disanitasi.
TRUST_PROXY="false"
# Terapkan migration yang belum dijalankan ketika Passenger direstart.
AUTO_MIGRATE="true"

# PostgreSQL cPanel. Nama database/user biasanya memiliki prefiks akun cPanel.
PGHOST="127.0.0.1"
PGPORT="5432"
PGDATABASE="akun_portal"
PGUSER="akun_portal"
PGPASSWORD=""
PGPOOL_MAX="3"

# Folder foto privat di luar Application root agar tetap ada ketika aplikasi
# diperbarui. Buat sendiri melalui File Manager, contoh:
# /home/akun-cpanel/portal-desa-media
# Jika baris ini dikosongkan, portal menggunakan .portal-desa-media di
# Application root (aman untuk pemasangan awal, tetapi wajib ikut dibackup).
MEDIA_UPLOAD_DIR="/home/akun-cpanel/portal-desa-media"
