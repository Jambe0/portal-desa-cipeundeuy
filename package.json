{
  "name": "portal-desa-cipeundeuy",
  "version": "0.88.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "pnpm run build && node --test tests/auth-security.test.mjs tests/rendered-html.test.mjs",
    "test:unit": "node --test tests/auth-security.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern release",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:doctor": "node scripts/doctor.mjs",
    "db:seed": "node scripts/seed.mjs",
    "admin:create": "node scripts/create-admin.mjs",
    "maintenance": "node scripts/maintenance.mjs",
    "secret:generate": "node scripts/generate-secret.mjs",
    "domainesia:build": "next build --webpack",
    "domainesia:package": "pnpm run domainesia:build && node scripts/package-domainesia.mjs",
    "domainesia:lock": "node scripts/lock-domainesia.mjs",
    "source:package": "node scripts/package-source.mjs",
    "domainesia:start": "node app_wrapper.cjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "dotenv": "17.2.3",
    "next": "16.2.12",
    "pg": "8.16.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "type": "module"
}
